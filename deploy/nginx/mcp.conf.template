# nginx vhost for the Moodle MCP server. Replace ${MCP_DOMAIN} (e.g. mcp.example.com) and ${MCP_PORT} (default 8791),
# e.g.:  MCP_DOMAIN=mcp.example.com MCP_PORT=8791 envsubst '${MCP_DOMAIN} ${MCP_PORT}' < mcp.conf.template > /etc/nginx/sites-available/mcp.conf
# Then: ln -s ../sites-available/mcp.conf /etc/nginx/sites-enabled/ && certbot --nginx -d ${MCP_DOMAIN} && nginx -t && systemctl reload nginx
server {
  listen 80; listen [::]:80;
  server_name ${MCP_DOMAIN};
  location /.well-known/acme-challenge/ { root /var/www/html; }
  location / { return 301 https://$host$request_uri; }
}
server {
  listen 443 ssl; listen [::]:443 ssl; http2 on;
  server_name ${MCP_DOMAIN};
  # ssl_certificate / ssl_certificate_key: added by certbot (or your Cloudflare origin cert)
  client_max_body_size 64M;            # create_resource / create_h5pactivity uploads
  access_log /var/log/nginx/mcp.access.log;
  error_log  /var/log/nginx/mcp.error.log;

  # Optional IP allowlist (recommended): only your agent's egress IPs / Cloudflare ranges.
  # allow 203.0.113.0/24;
  # deny all;

  location / {
    proxy_pass http://127.0.0.1:${MCP_PORT};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Connection "";
    proxy_set_header Authorization $http_authorization;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    # Streamable HTTP / SSE: no buffering, long timeouts
    proxy_buffering off; proxy_cache off; proxy_request_buffering off;
    chunked_transfer_encoding on;
    proxy_read_timeout 3600s; proxy_send_timeout 3600s;
    add_header X-Accel-Buffering no;
  }
}

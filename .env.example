# Copy to deploy/.env (chmod 600). Never commit the filled-in file.
# Moodle REST endpoint. Host MUST equal Moodle's $CFG->wwwroot host (otherwise Moodle answers HTTP 303).
MOODLE_WS_ENDPOINT=https://moodle.example.com/webservice/rest/server.php
# Contents of the token file written by moodle-setup/setup_ubionai_ws.php (step 2 of INSTALL.md).
MOODLE_TOKEN=
# Bearer token clients must send. Generate with: openssl rand -hex 32
MCP_BEARER_TOKEN=
# Optional (blank = default)
MCP_PORT=8791
MOODLE_EDITINGTEACHER_ROLE_ID=3
LOG_LEVEL=INFO
